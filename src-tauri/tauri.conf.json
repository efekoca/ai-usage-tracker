{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Tracker",
  "mainBinaryName": "ai-usage-tracker",
  "version": "0.2.1",
  "identifier": "io.aiusagetracker.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AI Usage Tracker contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Private, local tracker for AI tool usage, cost and limits",
    "longDescription": "Reads usage metadata that Claude Code, Cowork, the Claude desktop app and Codex already write on your computer, keeps a local archive and shows API-equivalent cost and plan limits. No content is stored and nothing leaves your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRTQxMDgwQkZGNjU0QjUKUldTMVZQYS9nQkRrWStJM2ZtRnV3U2VQbWJ6ME1oNGp6eUlzN3FkZGtETVNxQjNKekJUa3lBVmkK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
